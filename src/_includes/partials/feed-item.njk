{# Renderiza um item do feed. O corpo por tipo vem de post-body.njk;
   aqui fica só o chrome do feed (meta, título de post longo, permalink). #}

<article class="feed-item post-type-{{ post.data.type }}">

  <div class="post-meta">
    <time datetime="{{ post.date | dateISO }}">{{ post.date | dateReadable }}</time>
  </div>

  {% if post.data.type == "post" %}
    <h2 class="post-title">
      <a href="{{ post.url }}">{{ post.data.title }}</a>
    </h2>
    {% if post.data.description %}
      <p class="post-content">{{ post.data.description }}</p>
    {% endif %}
    <a href="{{ post.url }}" class="read-more">ler</a>
  {% else %}
    {% set pb = post.data %}
    {% set pbContent = post.templateContent %}
    {% set pbMode = "feed" %}
    {% include "partials/post-body.njk" %}
    <a href="{{ post.url }}" class="post-permalink" aria-label="link permanente">#</a>
  {% endif %}

</article>
