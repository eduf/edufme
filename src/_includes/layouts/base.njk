<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {% set pageTitle = title if title else site.name %}
  {% set pageDescription = description if description else site.description %}
  {% set pageUrl = site.url + page.url %}
  {% if image %}
    {% set pageImage = (site.url + image) if 'http' not in image else image %}
  {% endif %}

  <title>{% if title and title != false %}{{ title }} — eduf.me{% else %}eduf.me — Site do jornalista e roteirista Eduardo Fernandes{% endif %}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="author" content="{{ site.author }}">
  <link rel="canonical" href="{{ pageUrl }}">

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{{ 'article' if type == 'post' else 'website' }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  {% if pageImage %}<meta property="og:image" content="{{ pageImage }}">{% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="{{ 'summary_large_image' if pageImage else 'summary' }}">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  {% if pageImage %}<meta name="twitter:image" content="{{ pageImage }}">{% endif %}

  <!-- JSON-LD -->
  {% if type == "post" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ title | dump | safe }},
    "description": {{ pageDescription | dump | safe }},
    "url": "{{ pageUrl }}",
    {% if pageImage %}"image": "{{ pageImage }}",{% endif %}
    "datePublished": "{{ page.date | dateISO }}",
    "author": {
      "@type": "Person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}/sobre"
    },
    "publisher": {
      "@type": "Person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}"
    }
  }
  </script>
  {% else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "author": {
      "@type": "Person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}/sobre"
    }
  }
  </script>
  {% endif %}

  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/main.css">
  <script>(function(){var t=localStorage.getItem('eduf-theme');if(t)document.documentElement.setAttribute('data-theme',t);})();</script>
  <link rel="alternate" type="application/rss+xml" title="eduf.me" href="/feed.xml">
</head>
<body>
<div class="tui-frame">

  <header class="tui-titlebar">
    <a href="/" class="tui-site-name" aria-label="eduf.me — página inicial">eduf.me</a>
    <span class="tui-context">jornalista · roteirista · eduardo fernandes</span>
    <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false">≡</button>
  </header>

  <div class="tui-layout">

    <div class="tui-sidebar">
      <a href="/" class="site-logo" aria-label="eduf.me — página inicial">eduf.me<span class="site-logo-cursor" aria-hidden="true">█</span></a>
      <nav aria-label="navegação principal">
      <ul class="site-nav">
        <li><a href="/sobre"
          {% if 'sobre' in page.url %}class="is-current"{% endif %}>sobre</a></li>
        <li><a href="https://textosobretela.com" target="_blank" rel="noopener">newsletter ↗</a></li>
        <li><a href="https://www.youtube.com/@edufme" target="_blank" rel="noopener">vídeos ↗</a></li>
        <li><a href="https://textosobretela.com/podcast/archive?sort=new">áudio ↗</a></li>
        <li><a href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#101;&#100;&#117;&#102;&#64;&#101;&#100;&#117;&#102;&#46;&#109;&#101;">contato</a></li>
        <li><a href="/feed.xml">rss</a></li>
      </ul>
      </nav>
      <div class="tui-theme-picker">
        <label class="tui-theme-label" for="theme-select">tema</label>
        <select id="theme-select" class="theme-select">
          <option value="gruvbox-light">gruvbox·light</option>
          <option value="gruvbox-dark">gruvbox·dark</option>
          <option value="dracula">dracula</option>
          <option value="solarized">solarized·dark</option>
          <option value="claude-code">claude·code</option>
        </select>
      </div>
    </div>

    <main class="tui-main">
      {{ content | safe }}
    </main>

  </div>

  <footer class="tui-statusbar">
    <span>© Eduardo Fernandes</span>
  </footer>

</div>

<script>
  // Prefetch de links internos
  document.querySelectorAll('a[href^="/"]').forEach(link => {
    const prefetch = document.createElement('link');
    prefetch.rel = 'prefetch';
    prefetch.href = link.href;
    document.head.appendChild(prefetch);
  });

  // Hamburger menu
  const navToggle = document.querySelector('.nav-toggle');
  const sidebar   = document.querySelector('.tui-sidebar');
  if (navToggle && sidebar) {
    navToggle.addEventListener('click', () => {
      const isOpen = sidebar.classList.toggle('is-open');
      navToggle.setAttribute('aria-expanded', String(isOpen));
      navToggle.textContent = isOpen ? '✕' : '≡';
    });
    // Fecha ao clicar num link do menu
    sidebar.querySelectorAll('a').forEach(a =>
      a.addEventListener('click', () => {
        sidebar.classList.remove('is-open');
        navToggle.setAttribute('aria-expanded', 'false');
        navToggle.textContent = '≡';
      })
    );
  }

  // Seletor de tema
  const themeSelect = document.getElementById('theme-select');
  const savedTheme  = localStorage.getItem('eduf-theme');

  if (themeSelect) {
    if (savedTheme) themeSelect.value = savedTheme;

    themeSelect.addEventListener('change', () => {
      const name = themeSelect.value;
      document.documentElement.setAttribute('data-theme', name);
      localStorage.setItem('eduf-theme', name);
    });
  }
</script>
</body>
</html>
