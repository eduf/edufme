<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# CSP via meta (o _headers valeria também para /admin/, que precisa de política própria).
     O hash sha256 cobre o script inline anti-FOUC abaixo — se editar o script,
     recalcule: printf '%s' "<conteúdo do script>" | openssl dgst -sha256 -binary | openssl base64 -A #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'sha256-UBN+bGrOXnJJmDGqWkSGwXFn436bcNs3ZphiQf4Av+U='; style-src 'self'; img-src 'self' data:; font-src 'self'; frame-src https://anchor.fm https://omny.fm https://open.spotify.com https://www.youtube.com https://www.youtube-nocookie.com; media-src https://anchor.fm https://d3ctxlq1ktw2nl.cloudfront.net; object-src 'none'; base-uri 'self'; form-action 'self'">

  {% set pageTitle = title if title else site.name %}
  {% set pageDescription = description if description else site.description %}
  {% set pageUrl = site.url + page.url %}
  {% if image %}
    {% set pageImage = image if image.startsWith('http') else (site.url + image) %}
  {% elif type %}
    {% set bodyImage = page.rawInput | firstImageUrl(page.inputPath) %}
    {% if bodyImage %}{% set pageImage = site.url + bodyImage %}{% endif %}
  {% endif %}

  <title>{% if title %}{{ title }} — eduf.me{% else %}eduf.me — Site do jornalista e roteirista Eduardo Fernandes{% endif %}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="author" content="{{ site.author }}">
  <link rel="canonical" href="{{ pageUrl }}">

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{{ 'article' if type == 'post' else 'website' }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  {% if pageImage %}<meta property="og:image" content="{{ pageImage }}">{% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="{{ 'summary_large_image' if pageImage else 'summary' }}">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  {% if pageImage %}<meta name="twitter:image" content="{{ pageImage }}">{% endif %}

  <!-- JSON-LD -->
  {% if type == "post" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ title | dump | safe }},
    "description": {{ pageDescription | dump | safe }},
    "url": "{{ pageUrl }}",
    {% if pageImage %}"image": "{{ pageImage }}",{% endif %}
    "datePublished": "{{ page.date | dateISO }}",
    "author": {
      "@type": "Person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}/sobre"
    },
    "publisher": {
      "@type": "Person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}"
    }
  }
  </script>
  {% else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "author": {
      "@type": "Person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}/sobre"
    }
  }
  </script>
  {% endif %}

  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="manifest" href="/manifest.json">
  <link rel="preload" href="/assets/fonts/iAWriterDuoS-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css">
  <script>(function(){var t=localStorage.getItem('eduf-theme');if(t)document.documentElement.setAttribute('data-theme',t);})();</script>
  <link rel="alternate" type="application/rss+xml" title="eduf.me" href="/feed.xml">
</head>
<body>
<a class="skip-link" href="#conteudo">pular para o conteúdo</a>
<div class="tui-frame">

  <header class="tui-titlebar">
    <a href="/" class="tui-site-name" aria-label="eduf.me — página inicial">eduf.me</a>
    <span class="tui-context">jornalista · roteirista · eduardo fernandes</span>
    <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false">≡</button>
  </header>

  <div class="tui-layout">

    <div class="tui-sidebar">
      <a href="/" class="site-logo" aria-label="eduf.me — página inicial">eduf.me<span class="site-logo-cursor" aria-hidden="true">█</span></a>
      <nav aria-label="navegação principal">
      <ul class="site-nav">
        <li><a href="/sobre"
          {% if 'sobre' in page.url %}class="is-current"{% endif %}>sobre</a></li>
        <li><a href="https://textosobretela.com" target="_blank" rel="noopener">newsletter ↗</a></li>
        <li><a href="https://www.youtube.com/@edufme" target="_blank" rel="noopener">vídeos ↗</a></li>
        <li><a href="https://textosobretela.com/podcast/archive?sort=new">áudio ↗</a></li>
        <li><a href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#101;&#100;&#117;&#102;&#64;&#101;&#100;&#117;&#102;&#46;&#109;&#101;">contato</a></li>
        <li><a href="/feed.xml">rss</a></li>
        <li><a href="/notificacoes"
          {% if 'notificacoes' in page.url %}class="is-current"{% endif %}>notificações</a></li>
        <li><a href="/tags"
          {% if page.url == '/tags/' %}class="is-current"{% endif %}>tags</a></li>
      </ul>
      </nav>
      <div class="tui-theme-picker">
        <label class="tui-theme-label" for="theme-select">tema</label>
        <select id="theme-select" class="theme-select">
          <option value="gruvbox-light">gruvbox·light</option>
          <option value="gruvbox-dark">gruvbox·dark</option>
          <option value="dracula">dracula</option>
          <option value="solarized">solarized·dark</option>
          <option value="claude-code">claude·code</option>
        </select>
      </div>
    </div>

    <main class="tui-main" id="conteudo">
      {{ content | safe }}
    </main>

  </div>

  <footer class="tui-statusbar">
    <span>© Eduardo Fernandes</span>
  </footer>

</div>

<script src="/assets/js/site.js"></script>
</body>
</html>
