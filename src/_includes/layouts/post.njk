---
layout: base.njk
---

<div class="container">
  <article class="post-single post-type-{{ type }}">

    {% if title %}
      <h1 class="post-title">{{ title }}</h1>
    {% endif %}

    <div class="post-meta">
      <time datetime="{{ page.date | dateISO }}">{{ page.date | dateReadable }}</time>
      <a href="/sobre" class="post-author">{{ site.author }}</a>
    </div>

    {% if coverImage %}
      <div class="post-cover">
        <img src="{{ coverImage }}" alt="{{ title }}">
      </div>
    {% endif %}

    <div class="post-content">
      {% if type == "quote" %}
        <blockquote>{{ quote }}</blockquote>
        {% if source %}<p class="quote-source">{{ source }}</p>{% endif %}
        {% if content %}{{ content | safe }}{% endif %}
      {% elif type == "link" %}
        <p class="link-title"><a href="{{ url }}" target="_blank" rel="noopener">{{ title }}</a></p>
        {% if content %}{{ content | safe }}{% endif %}
      {% else %}
        {{ content | safe }}
      {% endif %}
    </div>

  </article>
</div>
