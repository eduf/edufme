---
layout: base.njk
---

<div class="container">
  <article class="post-single post-type-{{ type }}">

    {% if title %}
      {% if type == "link" %}
        <h1 class="post-title"><a href="{{ url }}" target="_blank" rel="noopener">{{ title }}</a></h1>
      {% else %}
        <h1 class="post-title">{{ title }}</h1>
      {% endif %}
    {% endif %}

    <div class="post-meta">
      <time datetime="{{ page.date | dateISO }}">{{ page.date | dateReadable }}</time>
      <a href="/sobre" class="post-author">{{ site.author }}</a>
    </div>

    {% set socialPost = posse[page.url] %}
    {% if socialPost and (socialPost.mastodonUrl or socialPost.blueskyUrl) %}
      <div class="post-social-links" aria-label="conversas sobre este texto">
        {% if socialPost.mastodonUrl %}
          <a href="{{ socialPost.mastodonUrl }}" target="_blank" rel="noopener">comentar no Mastodon</a>
        {% endif %}
        {% if socialPost.blueskyUrl %}
          <a href="{{ socialPost.blueskyUrl }}" target="_blank" rel="noopener">ver no Bluesky</a>
        {% endif %}
      </div>
    {% endif %}

    {% if coverImage %}
      <div class="post-cover">
        <img src="{{ coverImage }}" alt="{{ title }}">
      </div>
    {% endif %}

    <div class="post-content">
      {% if type == "quote" %}
        <blockquote>{{ quote }}</blockquote>
        {% if source %}<p class="quote-source">{{ source }}</p>{% endif %}
        {% if content %}{{ content | safe }}{% endif %}
      {% elif type == "link" %}
        {% if content %}{{ content | safe }}{% endif %}
      {% else %}
        {{ content | safe }}
      {% endif %}
    </div>

  </article>
</div>
